{
  "name": "architect-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,cyan \"vite --port 5180\" \"\\\"$npm_node_execpath\\\" --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local --watch server/dev.ts\"",
    "web": "vite --port 5180",
    "api": "\"$npm_node_execpath\" --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local --watch server/dev.ts",
    "build": "tsc -p . && vite build",
    "typecheck": "tsc -p .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@neondatabase/serverless": "^1.2.0",
    "hono": "^4.13.12",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
